# WhatsApp business number: country code + number, digits only (no +)
# VISO order line: +961 71 408 822 → 96171408822
NEXT_PUBLIC_WHATSAPP_ORDER_NUMBER=96171408822

# GitHub Pages project site (repo name): leading slash, no trailing slash
# `next dev` ignores this unless you set NEXT_PUBLIC_FORCE_BASE_PATH_IN_DEV=true (see README)
# NEXT_PUBLIC_BASE_PATH=/VISO
# NEXT_PUBLIC_FORCE_BASE_PATH_IN_DEV=true

# Canonical URL for metadata (OG, etc.). Match your Pages URL.
# NEXT_PUBLIC_SITE_URL=https://cowebslb.github.io/VISO

# Optional: echoed in meta for cache-bust debugging
NEXT_PUBLIC_BUILD_ID=local

# Supabase (anon key only — safe in browser; never put service role in NEXT_PUBLIC_*)
# Required for build-time catalog paths and checkout; use Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
