# WhatsApp business number: country code + number, digits only (no +)
# Example for Lebanon: 96171234567
NEXT_PUBLIC_WHATSAPP_ORDER_NUMBER=9610000000

# GitHub Pages project site (repo name): leading slash, no trailing slash
# Leave empty for local dev at http://localhost:3000
# NEXT_PUBLIC_BASE_PATH=/VISO

# Canonical URL for metadata (OG, etc.). Match your Pages URL.
# NEXT_PUBLIC_SITE_URL=https://cowebslb.github.io/VISO

# Optional: echoed in meta for cache-bust debugging
NEXT_PUBLIC_BUILD_ID=local
