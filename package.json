  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next.mjs",
    "dev": "next dev -p 3040",
    "dev:turbopack": "next dev -p 3040 --turbopack",
    "dev:webpack": "next dev -p 3040",
    "dev:clean": "npm run clean && npm run dev",
